{
  "manifest_version": 3,
  "name": "ZyncIT",
  "description": "Sync SMS, Calls and Chat between your devices",
  "version": "1.0.0",
  "permissions": ["storage", "notifications", "identity", "alarms"],
  "host_permissions": [
    "https://*.firebaseio.com/*",
    "https://*.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.firebaseapp.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "oauth2": {
    "client_id": "772958487002-a4edj7ppjdf4l4lh5b55g9honi4tajlo.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "key": ""
}
